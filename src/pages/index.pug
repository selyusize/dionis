extends ../layouts/base.pug

block title
  title Приемка квартир | Дионис

block content
  section.hero.blue-theme
    .container 
      div.hero__title
        h1 Приемка квартир в новостройке
        p.paragraph Широкий профиль, гарантия качества и внимание к деталям! 
      a(href="#").btn.btn--primary Подробнее
  section.blue-theme.blue-bg.why
    .container
      div
        .tag.h6
         img(src="../assets/img/svg/Ellipse.svg", alt="ellipse")
         h6 о компании
        h2.mb-40 Почему выбирают<br class="mobile-hidden"> именно нас
      div.why__description
        p.paragraph «ДИОНИС» — многопрофильная строительная компания, объединяющая экспертов в сфере технического надзора, проектирования и строительства.
        p.paragraph Мы не просто проверяем качество — мы создаём его на всех этапах: от проектной документации до сдачи объекта «под ключ»
      div.why__list.white-theme
        div.why__list--item
          h3 1000+ объектов
          p.paragraph Успешно проверили по ГОСТ и СНиП
        div.why__list.white-theme
          div.why__list--item
            h3 Состоим в СРО
            p.paragraph Имеем допуски НОСТРОЙ и НОПРИЗ
        div.why__list.white-theme
          div.why__list--item
            h3 20+ лет опыта
            p.paragraph В строительстве и контроле качества
  section.white-theme.white-bg.services
    .container
      div
        .tag.h6
          img(src="../assets/img/svg/h6.svg", alt="ellipse")
          h6 Услуги
        h2.mb-40 С чем мы можем вам помочь
      article.priemka
        .priemka__description
          h3 Приемка квартир
          p.paragraph Осмотр с помощью проф-оборудования, фото и видео-фиксация дефектов и оформление акта по СП, ГОСТ, ПУЭ.
        a(href="#").btn.btn--secondary Подробнее
      .services-list 
        .services-list__item 
          .services-list__item--title
            h4 Инженерные изыскания
            p.paragraph Выявляем дефекты, оцениваем состояние здания и оформляем техническое заключение
          .services-list__item--image 
            img(src="../assets/img/services/services1.jpg", alt="services1")
        .services-list__item 
          .services-list__item--title
            h4 Строительный контроль
            p.paragraph Проверка качества и соответствия работ проектной документации и нормативным требованиям
          .services-list__item--image 
            img(src="../assets/img/services/services2.jpg", alt="services2")
        .services-list__item 
          .services-list__item--title
            h4 Авторский<br class="table-hidden" /> надзор
            p.paragraph Контроль соответствия строительства проектным решениям от лица разработчика
          .services-list__item--image 
            img(src="../assets/img/services/services3.jpg", alt="services3")
        .services-list__item 
          .services-list__item--title
            h4.desktop-nowrap Обследование<br class="table-hidden" /> зданий и сооружений
            p.paragraph Диагностика оснований и несущих конструкций с выдачей технического заключения
          .services-list__item--image 
            img(src="../assets/img/services/services4.jpg", alt="services4")
        .services-list__item 
          .services-list__item--title
            h4 Работы по проектированию
            p.paragraph Проектирование жилых, общественных и промышленных объектов с нуля под ключ
          .services-list__item--image 
            img(src="../assets/img/services/services5.jpg", alt="services5")
        .services-list__item 
          .services-list__item--title
            h4.desktop-nowrap Строительно- <br class="table-hidden" />судебные экспертизы 
            p.paragraph Анализ и оценка строительных объектов для разрешения споров и представления в суде
          .services-list__item--image 
            img(src="../assets/img/services/services6.jpg", alt="services6")
  section.blue-theme.blue-bg.reviews
    .container
      .tag.h6
         img(src="../assets/img/svg/Ellipse.svg", alt="ellipse")
         h6 Отзывы
      h2.mb-40 Что говорят<br class="mobile-hidden desktop-hidden"> наши клиенты

