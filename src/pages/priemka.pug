extends ../layouts/base.pug

block title
  title Приёмка квартир | Дионис

block content
  section.hero.blue-theme
    .container 
      div.hero__title
        h1 Приёмка квартир
      a(href="#").btn.btn--primary Записаться на приёмку
  section.blue-theme.blue-bg
    .container
      div
        .tag.h6
         img(src="../assets/img/svg/Ellipse.svg", alt="ellipse")
         h6 об услуге
        h2.mb-40 Что входит в приёмку квартиры?
      div.why__description
        p.paragraph Согласуем удобное время, приедем и проведём тщательный осмотр по стандартам СП, ГОСТ и ПУЭ. Зафиксируем все выявленные недостатки, в том числе на фото и видео, а в конце передадим вам подробный акт осмотра с рекомендациями от эксперта.
      div 
        h2 В ходе осмотра проверяем
      .check-list
        .check-list__item
          h4 Геометрические параметры квартиры 
          p.paragraph Проверяем ровность стен, уровень пола, стяжки, углы и размеры помещений
        .check-list__item
          h4 Инженерные коммуникации
          p.paragraph Проверяем ровность стен, уровень пола, стяжки, углы и размеры помещений
        .check-list__item
          h4 Качество черновой и чистовой отделки  
          p.paragraph Проверяем ровность стен, уровень пола, стяжки, углы и размеры помещений
        .check-list__item
          h4 Качество дверных и оконных конструкций 
          p.paragraph Проверяем ровность стен, уровень пола, стяжки, углы и размеры помещений
  section.white-theme.white-bg.services-instruments
    .container
      div.slider-title-instruments 
        div
          .tag.h6
            img(src="../assets/img/svg/h6.svg", alt="ellipse")
            h6 Оборудование
          h2.mb-40 Используемые инструменты
        div.why__description
          p.paragraph Наши специалисты приезжают со своим набором поверенных и сертифицированных инструментов — всё откалибровано и соответствует стандартам, чтобы вы получили объективную и надёжную оценку
      .slider-techs 
        .slider-techs__track 
          .slider-item 
            img(src="../assets/img/instruments/seconds.jpg", alt="секундомер")
            h3 Секундомер электронный
          .slider-item 
            img(src="../assets/img/instruments/baromert.jpg", alt="барометр")
            h3 Барометр
          .slider-item 
            img(src="../assets/img/instruments/manometr.jpg", alt="секундомер")
            h3 Дифференциальный манометр
          .slider-item 
            img(src="../assets/img/instruments/manometr2.jpg", alt="секундомер")
            h3 Манометр
          .slider-item 
            img(src="../assets/img/instruments/oscilograph.jpg", alt="секундомер")
            h3 Цифровой осциллограф
          .slider-item 
            img(src="../assets/img/instruments/vesi.jpg", alt="секундомер")
            h3 Крановые весы
        .slider-techs__controll 
          div 
            .slider-controllers
              button.controller.disable.prev
                img(src="../assets/img/svg/arrow-btn-slider.svg", alt="arrow")
              button.controller.active.next
                img(src="../assets/img/svg/arrow-btn-slider.svg", alt="arrow")
            .slider-scroll-progress
              .progress
  section.white-theme.white-bg.services
    .container
      div
        .tag.h6
          img(src="../assets/img/svg/h6.svg", alt="ellipse")
          h6 Тарифы
        h2.mb-40 Сколько стоит приёмка квартиры
      .tarif-list 
        .tarif.tarif-white
          .tarif-tag
            img(src="../assets/img/svg/h6.svg", alt="ellips")
            span Тариф 1
          .tarif--title 
            h4 Площать квартиры
            span До 40 м²
            p Оптимальное решение для студий и небольших квартир. Полная проверка за фиксированную цену
          .tarif--price 
            span Стоимость
            span.tarif--price--num 4 000 руб.
          button.tarif--buy Заказать приёмку
        .tarif.tarif-blue
          .tarif-tag
            img(src="../assets/img/svg/Ellipse.svg", alt="ellips")
            span Тариф 2
          .tarif--title 
            h4 Площать квартиры
            span От 40 м²
            p Подходит для просторных квартир и апартаментов. Стоимость зависит от метража
          .tarif--price 
            span Стоимость
            span.tarif--price--num 100 руб. / м²
          button.tarif--buy Заказать приёмку
  